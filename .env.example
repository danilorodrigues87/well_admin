# URL pública (sem barra final). Em local: http://localhost/pjt/admin.well.eco
URL=http://localhost/pjt/admin.well.eco

SITE=Well Eco Admin
COMPANY_NAME=Well Soluções Ambientais
COMPANY_SHORT_NAME=Well S.A.
TIMEZONE=America/Sao_Paulo
MAINTENANCE=false

DB_HOST=localhost
DB_NAME=well_admin
DB_USER=root
DB_PASS=

# Senha inicial do admin seed (alterar após primeiro login)
ADMIN_EMAIL=admin@well.eco
ADMIN_PASSWORD=WellEco@2026
ADMIN_NAME=Administrador Well

# Coleta / MTR (defaults Well)
COLETA_TRANSPORTADOR=Well Soluções Ambientais
COLETA_TRANSPORTADOR_CNPJ=18.675.233/0001-50
COLETA_DESTINADOR=Well Soluções Ambientais
COLETA_DESTINADOR_CNPJ=18.675.233/0001-50
COLETA_DIAS_PROXIMA=7

# SINIR — integração MTR nacional
# Token gerado em mtr.sinir.gov.br > Configurações > Gerar Token API WS
SINIR_ENABLED=false
SINIR_ENV=production
SINIR_UNIDADE=135551
SINIR_UNIDADE_DESTINADOR=
SINIR_CNPJ=18675233000150
SINIR_INTEGRATION_TOKEN=
# Dev local XAMPP (erro SSL curl #60): SINIR_SSL_VERIFY=false
SINIR_SSL_VERIFY=true

# API REST — app coletor FlutterFlow (Fase 2)
API_ENABLED=true
API_JWT_SECRET=altere-para-uma-chave-segura-com-32-caracteres-ou-mais
API_JWT_TTL=86400
API_CORS_ORIGINS=*

# Banco Inter — Cobrança BolePix (boleto + PIX)
# Certificados: storage/inter/certificado.crt e storage/inter/chave.key
INTER_ENABLED=false
INTER_ENV=production
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CONTA_CORRENTE=
INTER_CNPJ=18675233000150
INTER_CERT_PATH=
INTER_KEY_PATH=
INTER_KEY_PASSWORD=
INTER_SCOPE="boleto-cobranca.read boleto-cobranca.write webhook.read webhook.write"
INTER_WEBHOOK_URL=
INTER_WEBHOOK_SECRET=

# Cobrança — multa e juros padrão (editável também no painel)
COBRANCA_MULTA_TIPO=PERCENTUAL
COBRANCA_MULTA_TAXA=2.00
COBRANCA_MULTA_VALOR=0.00
COBRANCA_MORA_TIPO=TAXAMENSAL
COBRANCA_MORA_TAXA=1.00
COBRANCA_MORA_VALOR=0.00

# E-mail — envio de boletos (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@well.eco.br
MAIL_FROM_NAME=Well S.A.
# XAMPP local: se STARTTLS falhar, use MAIL_PORT=465 e MAIL_ENCRYPTION=ssl
# MAIL_SSL_VERIFY=false
